PORT=5000
NODE_ENV=production
# Optional override; without a database name in MONGO_URI, the backend uses "test".
# MONGO_DB_NAME=test
MONGO_URI=mongodb+srv://amar_db_user17:amar_db_user17@amarproject.t0kavnu.mongodb.net/
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
FRONTEND_URL=http://localhost:8443
GOOGLE_CLIENT_ID=your-google-web-client-id
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_SECRET=replace-with-a-long-random-admin-secret

# Optional local demo setup (development only):
# 1. Run a MongoDB server on this computer.
# 2. Put these settings in Backend/.env.local; choose your own DEMO_PASSWORD.
# 3. Run `npm run seed:demo` from Backend. Seeded data remains in this database
#    across app restarts. The seed command is never run automatically.
# NODE_ENV=development
# MONGO_URI=mongodb://127.0.0.1:27017/medconnect_demo
# MONGO_DB_NAME=medconnect_demo
# DEMO_MONGO_URI=mongodb://127.0.0.1:27017/medconnect_demo
# ALLOW_DEMO_SEED=true
# DEMO_PASSWORD=choose-a-local-password-of-12-characters-or-more
